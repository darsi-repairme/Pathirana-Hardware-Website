# Server-only. The browser never talks to the API directly: every request goes
# through this admin server, which attaches the staff session.
BACKEND_API_URL=http://127.0.0.1:4000

# Must match the API's JWT_EXPIRES_IN (default 8h), in seconds.
ADMIN_SESSION_MAX_AGE=28800

# Set to true only when served over HTTPS (production): marks the session cookie Secure.
ADMIN_COOKIE_SECURE=false

# true only behind a trusted reverse proxy that appends X-Forwarded-For: the
# last hop is then forwarded so the API rate-limits sign-ins per device (the API
# must also run with TRUST_PROXY=true). Leave false when exposed directly.
ADMIN_TRUST_PROXY=false

# Optional (recommended in production): the same value as the API's ADMIN_CLIENT_SECRET (32+ random
# characters, server-side only). Remembers signed-in devices with a signed HttpOnly cookie and tells
# the API which device/visitor a request comes from, so each has its own sign-in and rate-limit
# budget. Empty = previous behaviour. Changing it only makes devices "new" once (no sign-out).
ADMIN_CLIENT_SECRET=

# Public customer website address (no trailing slash). Adds "View Website" to the menu and
# "View on website" to published products, services, active categories and gallery photos.
# Leave empty to hide those links. Production example: https://www.your-domain.lk
WEBSITE_URL=http://127.0.0.1:4173
