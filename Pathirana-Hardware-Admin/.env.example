# Server-only. The browser never talks to the API directly: every request goes
# through this admin server, which attaches the staff session.
BACKEND_API_URL=http://127.0.0.1:4000

# Must match the API's JWT_EXPIRES_IN (default 8h), in seconds.
ADMIN_SESSION_MAX_AGE=28800

# Set to true only when served over HTTPS (production): marks the session cookie Secure.
ADMIN_COOKIE_SECURE=false

# true only behind a trusted reverse proxy that appends X-Forwarded-For: the
# last hop is then forwarded so the API rate-limits sign-ins per device (the API
# must also run with TRUST_PROXY=true). Leave false when exposed directly.
ADMIN_TRUST_PROXY=false
