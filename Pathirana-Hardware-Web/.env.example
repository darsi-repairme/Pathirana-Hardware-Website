# Copy to .env.local and fill in. Read by `next dev` and `next build` (values are baked into the build).

# REQUIRED. The website API (Pathirana-Hardware-Backend). The website shows ONLY the live database
# (services, products, categories, brands, gallery, offers), so a build without it is refused.
# Local Backend: http://127.0.0.1:4000  ·  Production: the public https API address.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# The public site address (canonical links, sitemap, Open Graph). Required for a production build
# that will be published; leave it out for local testing.
# NEXT_PUBLIC_SITE_URL=https://www.example.lk
