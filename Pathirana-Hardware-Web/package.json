{
  "name": "pathirana-hardware-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/serve-static.mjs out 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "node scripts/prepare-brand-assets.mjs",
    "gallery": "node scripts/prepare-gallery.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:build": "npm run build && node scripts/build-fixtures.mjs",
    "audit": "npm audit --audit-level=low",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:e2e:build && npm run test:e2e && npm audit",
    "test:live-stack": "node scripts/build-live-stack.mjs && playwright test -c playwright.live-stack.config.ts"
  },
  "dependencies": {
    "lucide-react": "1.62.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  }
}
