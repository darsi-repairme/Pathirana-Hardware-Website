# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000

# Separate website database (NOT the POS database).
DATABASE_URL=postgres://pathirana_web:CHANGE_ME@localhost:5432/pathirana_website
DATABASE_SSL=false

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of website origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:4173

# Product images are stored here (outside any public web root).
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=5

# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
LOG_LEVEL=log
