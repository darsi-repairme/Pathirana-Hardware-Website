# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000

# Separate website database (NOT the POS database).
DATABASE_URL=postgres://pathirana_web:CHANGE_ME@localhost:5432/pathirana_website
DATABASE_SSL=false
# With DATABASE_SSL=true the server certificate is always verified. For Supabase, also set the
# downloaded root CA (Dashboard → Database → Settings → SSL Configuration), e.g.:
# DATABASE_SSL_CA_FILE=./certs/supabase-ca.crt
DATABASE_SSL_CA_FILE=

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of website origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:4173

# Product images are stored here (outside any public web root).
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=5

# Media storage: local (files under UPLOAD_DIR) or supabase (two PRIVATE buckets, served via the API).
MEDIA_STORAGE=local
# For MEDIA_STORAGE=supabase (keep real values in the git-ignored .env.supabase):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=   (server-only secret key, sb_secret_…; never in the Admin or website)
# SUPABASE_CATALOGUE_BUCKET=catalogue-media
# SUPABASE_PRIVATE_BUCKET=quotation-photos

# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
LOG_LEVEL=log

# Quotation emails were retired (client decision 2026-11-20): no email provider,
# Resend key or sender is used. Customers send their request on WhatsApp instead.
